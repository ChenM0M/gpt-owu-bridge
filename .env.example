# Non-sensitive settings. The process does not load this file itself.
GATE_LISTEN=127.0.0.1:8080
GATE_LOG_LEVEL=info
GATE_DATA_DIR=./data
# GATE_PUBLIC_URL=https://gate.example.com
# GATE_OWU_BASE_URL=https://owu.example.com

# Prefer a mounted, read-only secret file. Never commit the referenced file.
# GATE_OWU_TOKEN_FILE=/run/secrets/owu_token
# GATE_OWU_TOKEN=replace-only-in-your-deployment-environment
